# Copy to .env.local for local development. Never put real secret values in this file.
# Every environment variable the project reads must be listed here (constitution Principle V).

# --- Demo variables from the scaffold (still read by the code; replaced when T012 rewrites config) ---
# Server-only demo secret, read by src/server/config.ts.
DEMO_SECRET=
# Public site name, copied into the browser bundle at build time (src/components/SiteName.tsx).
NEXT_PUBLIC_SITE_NAME=

# --- App and tests ---
# `real` uses AWS; `fake` uses in-memory stores and a scripted model for tests and CI.
AWS_MODE=fake
# Optional: run the Playwright tests against a deployed URL instead of a local build.
PLAYWRIGHT_BASE_URL=
# Optional: `1` seeds fake eval runs for the Evals page tests (T097).
SEED_EVALS=

# --- Server, scripts and eval runner ---
# AWS region for all clients (`us-east-2`; set automatically in Lambda).
AWS_REGION=us-east-2
# Bedrock model for the assistant (`anthropic.claude-haiku-5-5`).
BEDROCK_CHAT_MODEL_ID=
# Bedrock embedding model for retrieval and the index build (`amazon.titan-embed-text-v2:0`).
BEDROCK_EMBED_MODEL_ID=
# Bedrock model the eval runner uses as judge (`anthropic.claude-opus-5-5`).
BEDROCK_JUDGE_MODEL_ID=
# DynamoDB table for rate limits, spend, CV grants, conversations, traces and eval runs.
DYNAMO_TABLE_NAME=
# Private S3 bucket that holds the CV PDF.
CV_BUCKET_NAME=
# Object key of the CV PDF in that bucket.
CV_OBJECT_KEY=
# Name (not value) of the SSM SecureString with the HMAC key for visitor hashes and the prompt canary.
VISITOR_HASH_SECRET_PARAM=
# Daily model spending cap in USD (FR-021, default 0.25).
SPEND_CAP_DAILY_USD=0.25
# Monthly model spending cap in USD (FR-021, default 5).
SPEND_CAP_MONTHLY_USD=5
# Assistant messages allowed per visitor per hour (FR-020, default 20).
RATE_LIMIT_CHAT_PER_HOUR=20
# CV download links allowed per visitor per hour (FR-032, default 10).
RATE_LIMIT_CV_PER_HOUR=10
# The eval runner stops when a run reaches this cost in USD (default 1).
EVAL_MAX_COST_USD=1

# --- Public (copied into the browser bundle; not secrets) ---
# Canonical site URL.
NEXT_PUBLIC_SITE_URL=
# Umami analytics website ID (a public ID, not a credential). Leave empty to disable analytics.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# --- CDK (read by infra/, not by the app) ---
# Optional custom domain; when empty the site uses the CloudFront default domain.
DOMAIN_NAME=
# Recipient of the $5 and $8 AWS Budget alerts (FR-033).
BUDGET_ALERT_EMAIL=

# --- Set by CDK on the Lambda function, not by you (listed for reference) ---
# Starts the Lambda Web Adapter (`/opt/bootstrap`).
# AWS_LAMBDA_EXEC_WRAPPER=/opt/bootstrap
# Streams responses through the Web Adapter (`response_stream`).
# AWS_LWA_INVOKE_MODE=response_stream
# Port the Next.js server listens on (`3000`).
# AWS_LWA_PORT=3000
