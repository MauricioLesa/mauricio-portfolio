{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(**/.env.local)",
      "Bash(cat .env*)",
      "Bash(type .env*)",
      "Bash(Get-Content .env*)",
      "Bash(gc .env*)",
      "Bash(more .env*)",
      "Bash(less .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(grep * .env*)",
      "Bash(Select-String * .env*)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(echo $env:ANTHROPIC_API_KEY*)"
    ],
    "allow": [
      "Read(./.env.example)"
    ]
  }
}
